---
// Clickable path shown at the top of every sub-page (not the home page), e.g.
// Home / By Stack / Microsoft BI and Fabric. Ancestor crumbs with an `href`
// are links (same-tab, so View-Transition navigation is preserved); category
// crumbs without an href are plain labels; the final crumb is the current page.
interface Crumb {
  label: string;
  href?: string;
}
const { crumbs } = Astro.props as { crumbs: Crumb[] };
const last = crumbs.length - 1;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol class="breadcrumb__list">
    {
      crumbs.map((c, i) => (
        <li class="breadcrumb__item">
          {c.href ? (
            <a class="breadcrumb__link" href={c.href}>{c.label}</a>
          ) : (
            <span
              class={i === last ? "breadcrumb__current" : "breadcrumb__cat"}
              aria-current={i === last ? "page" : undefined}
            >
              {c.label}
            </span>
          )}
          {i < last && <span class="breadcrumb__sep" aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
