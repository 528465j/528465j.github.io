---
import profile from "../data/profile.json";
import WorkRightsChip from "./WorkRightsChip.astro";
---

<section id="contact" class="section">
  <div class="container">
    <div class="contact" data-reveal>
      <h2 class="contact__title">Contact</h2>

      <div class="contact__email-row">
        <a class="contact__email" href={`mailto:${profile.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          {profile.email}
        </a>
        <button class="copy-btn" type="button" data-copy-email={profile.email} aria-label="Copy email address to clipboard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>

      <WorkRightsChip />
    </div>
  </div>
</section>
