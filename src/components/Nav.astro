---
import { STACKS } from "../config/site";
import ThemeToggle from "./ThemeToggle.astro";

const here = (Astro.url.pathname.replace(/\/+$/, "") || "/");
const norm = (p: string) => p.replace(/\/+$/, "") || "/";
const is = (p: string) => here === norm(p);
const startsWith = (p: string) => here === norm(p) || here.startsWith(norm(p) + "/");

const themePages = [
  { href: "/analytics-bi/", label: "Analytics & BI" },
  { href: "/technical-ai-ml/", label: "Technical, AI & ML" },
];

const inProjects =
  startsWith("/analytics-bi") ||
  startsWith("/technical-ai-ml") ||
  startsWith("/stack") ||
  startsWith("/projects");
---

<header class="topbar">
  <div class="container topbar__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">JJ</span>
      <span>Jatin Jassi</span>
    </a>

    <div class="topbar__right">
      <nav class="nav" aria-label="Primary">
        <ul class="nav__links" id="primary-menu" data-nav-links>
          <li>
            <a class="nav-link" href="/" aria-current={is("/") ? "page" : undefined}>Home</a>
          </li>
          <li>
            <details class="dropdown" data-dropdown>
              <summary class="nav-link" aria-current={inProjects ? "page" : undefined}>
                Achievements/Projects
                <svg class="dropdown__caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div class="dropdown__panel dropdown__panel--nested">
                <button class="dropdown__cat" type="button" data-flyout="theme" aria-haspopup="true" aria-expanded="false" aria-controls="flyout-theme">
                  <svg class="dropdown__cat-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 18-6-6 6-6"></path>
                  </svg>
                  <span>By theme</span>
                </button>
                <div class="dropdown__sub" id="flyout-theme" data-flyout-panel="theme" hidden>
                  <p class="dropdown__group-label">By theme</p>
                  {
                    themePages.map((t) => (
                      <a class="dropdown__item" href={t.href} aria-current={is(t.href) ? "page" : undefined}>
                        {t.label}
                      </a>
                    ))
                  }
                </div>

                <button class="dropdown__cat" type="button" data-flyout="stack" aria-haspopup="true" aria-expanded="false" aria-controls="flyout-stack">
                  <svg class="dropdown__cat-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 18-6-6 6-6"></path>
                  </svg>
                  <span>By stack</span>
                </button>
                <div class="dropdown__sub" id="flyout-stack" data-flyout-panel="stack" hidden>
                  <p class="dropdown__group-label">By stack</p>
                  {
                    STACKS.map((s) => (
                      <a
                        class="dropdown__item"
                        data-stack-nav={s.id}
                        href={`/stack/${s.id}/`}
                        aria-current={is(`/stack/${s.id}/`) ? "page" : undefined}
                      >
                        {s.label}
                      </a>
                    ))
                  }
                </div>
              </div>
            </details>
          </li>
          <li>
            <a class="nav-link" href="/#contact">Contact</a>
          </li>
        </ul>
      </nav>

      <ThemeToggle />

      <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="primary-menu" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
