---
import Base from "../../layouts/Base.astro";
import ContactBlock from "../../components/ContactBlock.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ExperienceDetail from "../../components/ExperienceDetail.astro";
import profile from "../../data/profile.json";

export async function getStaticPaths() {
  return profile.experience.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

const { job } = Astro.props;
---

<Base
  title={`${job.title}, ${job.employer} | Jatin Jassi`}
  description={`Achievements and projects from ${job.title} at ${job.employer}.`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb
        crumbs={[
          { label: "Home", href: "/" },
          { label: "Experience", href: "/#experience" },
          { label: job.title },
        ]}
      />
      <span class="eyebrow">Achievements</span>
      <h1>{job.title}</h1>
      <p class="page-hero__lead"><b>{job.employer}</b> · {job.location} · {job.dates}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ExperienceDetail job={job} />
    </div>
  </section>

  <ContactBlock />
</Base>
