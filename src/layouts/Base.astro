---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/400-italic.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/500-italic.css";
import "@fontsource/roboto/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/lemmino.css";

import { ViewTransitions } from "astro:transitions";
import { SITE_URL } from "../config/site";
import profile from "../data/profile.json";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const desc = description ?? profile.tagline_default;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL("/og-image.svg", SITE_URL).href;
const rightsTail = profile.work_rights.replace(/^Full-time/, "");
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("theme");
          if (t !== "light" && t !== "dark") {
            t = "dark"; // LEMMiNO: dark is the primary theme; honour a stored choice otherwise
          }
          document.documentElement.setAttribute("data-theme", t);
          localStorage.setItem("theme", t); // persist so every page + navigation agrees
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
        // Arm the boot intro (change 2) before first paint so its curtain covers
        // the home page with no flash. Only on a fresh load of the home page (not
        // on in-site navigation) and never under reduced motion. A failsafe always
        // reveals it, so a failed boot script can never trap the visitor.
        try {
          var reduceMotion =
            window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (location.pathname === "/" && !reduceMotion) {
            document.documentElement.classList.add("booting");
            window.setTimeout(function () {
              document.documentElement.classList.remove("booting");
            }, 7000); // failsafe backstop, comfortably above the ~4.5s sequence
          }
        } catch (e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0e0e10" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <ViewTransitions />
  </head>

  <body class={isHome ? "has-intro at-top" : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <div>
          <p class="footer__brand">Jatin Jassi</p>
          <p class="footer__rights"><strong>Full-time</strong>{rightsTail}</p>
        </div>
        <nav class="footer__links" aria-label="Footer">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          <a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </nav>
        <p class="footer__legal">
          © {new Date().getFullYear()} Jatin Jassi · Sydney, NSW · Built with Astro
        </p>
      </div>
    </footer>

    <!-- Copy-confirmation toast (themed, auto-dismiss). Lives once at the body root. -->
    <div class="toast" role="status" aria-live="polite" data-toast>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
      <span data-toast-msg></span>
    </div>

    <script>
      function initThemeToggle() {
        const btn = document.querySelector("[data-theme-toggle]");
        if (!btn) return;
        btn.addEventListener("click", () => {
          const cur = document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light";
          const next = cur === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
        });
      }

      function initNav() {
        const toggle = document.querySelector("[data-nav-toggle]");
        const links = document.querySelector("[data-nav-links]");
        if (toggle && links) {
          toggle.addEventListener("click", () => {
            const open = links.classList.toggle("is-open");
            toggle.setAttribute("aria-expanded", String(open));
            toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
          });
          links.querySelectorAll("a").forEach((a) => {
            a.addEventListener("click", () => {
              links.classList.remove("is-open");
              toggle.setAttribute("aria-expanded", "false");
            });
          });
        }
        const dd = document.querySelector("[data-dropdown]");
        if (dd) {
          document.addEventListener("click", (e) => {
            if (dd.open && !dd.contains(e.target)) dd.open = false;
          });
        }
      }

      // Nested Projects dropdown: each category button opens its submenu (a left
      // flyout on desktop, an inline accordion on mobile). One open at a time.
      function initProjectsFlyout() {
        const cats = Array.from(document.querySelectorAll("[data-flyout]"));
        if (!cats.length) return;
        const panels = {};
        document.querySelectorAll("[data-flyout-panel]").forEach((p) => {
          panels[p.getAttribute("data-flyout-panel")] = p;
        });
        function closeAll() {
          cats.forEach((c) => c.setAttribute("aria-expanded", "false"));
          Object.keys(panels).forEach((k) => (panels[k].hidden = true));
        }
        cats.forEach((cat) => {
          cat.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const key = cat.getAttribute("data-flyout");
            const willOpen = cat.getAttribute("aria-expanded") !== "true";
            closeAll();
            if (willOpen) {
              cat.setAttribute("aria-expanded", "true");
              if (panels[key]) panels[key].hidden = false;
            }
          });
        });
        const dd = document.querySelector("[data-dropdown]");
        if (dd) dd.addEventListener("toggle", () => { if (!dd.open) closeAll(); });
      }

      function initLensToggle() {
        const group = document.querySelector("[data-lens-toggle]");
        if (!group) return;
        const params = new URLSearchParams(window.location.search);
        let active = params.get("lens") === "technical" ? "technical" : "business";
        function show(which) {
          active = which;
          group.querySelectorAll(".lens-toggle__btn").forEach((b) => {
            b.setAttribute("aria-pressed", String(b.dataset.lens === which));
          });
          document.querySelectorAll("[data-lens-view]").forEach((v) => {
            v.hidden = v.dataset.lensView !== which;
          });
        }
        group.querySelectorAll(".lens-toggle__btn").forEach((b) => {
          b.addEventListener("click", () => show(b.dataset.lens));
        });
        show(active);
      }

      function initContactCopy() {
        const btn = document.querySelector("[data-copy-email]");
        if (!btn) return;
        btn.addEventListener("click", async () => {
          const email = btn.getAttribute("data-copy-email") || "";
          try {
            await navigator.clipboard.writeText(email);
          } catch (e) {
            const ta = document.createElement("textarea");
            ta.value = email;
            ta.setAttribute("readonly", "");
            ta.style.position = "absolute";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand("copy");
            } catch (e2) {}
            document.body.removeChild(ta);
          }
          const label = btn.querySelector("[data-copy-label]");
          if (label) {
            const prev = label.textContent;
            label.textContent = "Copied";
            btn.classList.add("is-copied");
            window.setTimeout(() => {
              label.textContent = prev;
              btn.classList.remove("is-copied");
            }, 1600);
          }
        });
      }

      function initReveal() {
        const items = document.querySelectorAll("[data-reveal]");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduce || !("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      }

      // Re-apply the saved theme after each View-Transition swap. Astro copies the
      // incoming (static) document's <html> attributes onto the persistent element,
      // which would otherwise drop the runtime data-theme and revert to the CSS
      // default mid-navigation. Keeps the theme consistent across every page.
      function applyTheme() {
        var t;
        try {
          t = localStorage.getItem("theme");
        } catch (e) {}
        if (t !== "light" && t !== "dark") t = "dark";
        document.documentElement.setAttribute("data-theme", t);
      }

      // Home section index: pop-out toggle + scroll-spy active highlighting.
      let spyCleanup = null;
      function initScrollSpy() {
        if (spyCleanup) {
          spyCleanup();
          spyCleanup = null;
        }
        const spy = document.querySelector("[data-scrollspy]");
        if (!spy) return;
        const toggle = spy.querySelector("[data-scrollspy-toggle]");
        const links = Array.from(spy.querySelectorAll("[data-spy-link]"));
        const sections = links
          .map((a) => document.getElementById(a.getAttribute("data-spy-link")))
          .filter(Boolean);
        if (!toggle || !sections.length) return;

        function setOpen(open) {
          spy.classList.toggle("is-open", open);
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? "Close section index" : "Open section index");
        }
        function onToggle() {
          setOpen(!spy.classList.contains("is-open"));
        }
        function onKey(e) {
          if (e.key === "Escape") setOpen(false);
        }
        toggle.addEventListener("click", onToggle);
        // The index stays open when an option is clicked (change-set): only the
        // arrow (or Escape) collapses it, so it is not dismissed on navigation.
        document.addEventListener("keydown", onKey);

        // Active section = the last one whose top has passed a line 30% down the
        // viewport (a robust scroll-spy that does not bias toward short sections).
        let ticking = false;
        function update() {
          ticking = false;
          const line = window.innerHeight * 0.3;
          let activeId = sections[0].id;
          for (const s of sections) {
            if (s.getBoundingClientRect().top <= line) activeId = s.id;
            else break;
          }
          if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
            activeId = sections[sections.length - 1].id;
          }
          links.forEach((a) => {
            const on = a.getAttribute("data-spy-link") === activeId;
            a.classList.toggle("is-active", on);
            if (on) a.setAttribute("aria-current", "true");
            else a.removeAttribute("aria-current");
          });
        }
        function onScroll() {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(update);
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        update();

        spyCleanup = function () {
          toggle.removeEventListener("click", onToggle);
          document.removeEventListener("keydown", onKey);
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onScroll);
        };
      }

      // Copy-to-clipboard buttons that confirm with a themed toast (auto-dismiss 2s).
      function initEmailToast() {
        const btns = document.querySelectorAll("[data-copy-email-toast]");
        if (!btns.length) return;
        const toast = document.querySelector("[data-toast]");
        let toastTimer;
        async function copy(text) {
          try {
            await navigator.clipboard.writeText(text);
          } catch (e) {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.setAttribute("readonly", "");
            ta.style.position = "absolute";
            ta.style.left = "-9999px";
            document.body.appendChild(ta);
            ta.select();
            try {
              document.execCommand("copy");
            } catch (e2) {}
            document.body.removeChild(ta);
          }
        }
        function showToast(msg) {
          if (!toast) return;
          const label = toast.querySelector("[data-toast-msg]");
          if (label) label.textContent = msg;
          toast.classList.add("is-visible");
          window.clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => {
            toast.classList.remove("is-visible");
          }, 2000);
        }
        btns.forEach((btn) => {
          btn.addEventListener("click", async () => {
            await copy(btn.getAttribute("data-copy-email-toast") || "");
            showToast("Email copied in clipboard");
          });
        });
      }

      // Boot intro (change 2 + 3): the "ERROR 404: Conventional Analyst not found."
      // decoding screen, then the diagonal box reveal of the home page and the name
      // entrance. Runs only when the head script armed it (html.booting: home page,
      // fresh load, motion ok). 3-phase scramble (numbers -> symbols -> text). The
      // whole sequence runs ~4.5s (decode-in ~1.5s, a ~0.6s hold, the reverse
      // un-decode-out ~1.25s, then the ~1.15s reveal wipe ~= 4.5s total); the
      // curtain wipes away top-left -> bottom-right and the name halves converge.
      let bootCleanup = null;
      function initBoot() {
        if (bootCleanup) {
          bootCleanup();
          bootCleanup = null;
        }
        const html = document.documentElement;
        const boot = document.querySelector("[data-boot]");
        if (!boot || !html.classList.contains("booting")) return;
        const textEl = boot.querySelector("[data-boot-text]");
        const name = document.querySelector("[data-intro-name]");
        if (!textEl) {
          html.classList.remove("booting"); // nothing to animate: just reveal
          return;
        }

        const FINAL = "ERROR 404: Conventional Analyst not found.";
        const DIGITS = "0123456789";
        const SYMBOLS = "!<>-_\\/[]{}=+*^?#@%&$";
        const chars = FINAL.split("");
        const N = chars.length;
        // Compressed timing (change): the whole sequence lands ~4.5s (was ~9.4s;
        // an earlier ~2.7s pass read as too quick). Each pass is a left-to-right
        // stagger (SPREAD) plus a per-char settle (SETTLE); the decode-in (~1.5s)
        // and the un-decode-out (~1.25s) carry their own budgets, then a ~0.6s
        // hold and the ~1.15s reveal wipe.
        const IN_SPREAD = 0.83; // s: left-to-right sweep of the decode-in
        const IN_SETTLE = 0.67; // s: each char's digit -> symbol -> final settle
        const OUT_SPREAD = 0.67; // s: right-to-left sweep of the un-decode-out
        const OUT_SETTLE = 0.58; // s
        const HOLD = 600; // ms: fully-decoded hold
        const REVEAL = 1150; // ms: the box-reveal wipe (matches the CSS clip-path 1.15s)

        let raf = 0;
        const timers = [];

        function rnd(set) {
          return set.charAt((Math.random() * set.length) | 0);
        }
        // Phase mapping: final at p>=1, symbols in [0.5,1), digits in [0,0.5);
        // before a char's window it is still scrambling (in) or already gone (out).
        function glyph(p, ch, phase) {
          if (p >= 1) return ch;
          if (p >= 0.5) return rnd(SYMBOLS);
          if (p >= 0) return rnd(DIGITS);
          return phase === "in" ? rnd(DIGITS) : "";
        }
        function build(elapsed, phase, spread, settle) {
          let out = "";
          for (let i = 0; i < N; i++) {
            const ch = chars[i];
            if (ch === " ") {
              out += " ";
              continue;
            }
            let p;
            if (phase === "in") {
              p = (elapsed - (i / N) * spread) / settle; // left -> right reveal
            } else {
              p = 1 - (elapsed - ((N - 1 - i) / N) * spread) / settle; // right -> left exit
            }
            out += glyph(p, ch, phase);
          }
          return out;
        }
        function runPhase(phase, spread, settle, onDone) {
          const dur = spread + settle;
          const start = performance.now();
          let last = 0;
          function frame(now) {
            const elapsed = (now - start) / 1000;
            if (now - last >= 45) {
              last = now; // ~22fps glyph flicker: the decoding look without jitter
              textEl.textContent = build(elapsed, phase, spread, settle);
            }
            if (elapsed < dur) {
              raf = requestAnimationFrame(frame);
            } else {
              textEl.textContent = phase === "in" ? FINAL : "";
              onDone();
            }
          }
          raf = requestAnimationFrame(frame);
        }
        function reveal() {
          // Start the name entrance first so its halves begin hidden, then wipe the
          // curtain away diagonally to expose the home page.
          if (name) name.classList.add("is-entering");
          void boot.offsetWidth;
          boot.classList.add("is-revealing");
          const t = window.setTimeout(() => {
            html.classList.remove("booting"); // unlock scroll + drop the curtain
          }, REVEAL);
          timers.push(t);
        }

        try {
          runPhase("in", IN_SPREAD, IN_SETTLE, () => {
            const t = window.setTimeout(
              () => runPhase("out", OUT_SPREAD, OUT_SETTLE, reveal),
              HOLD
            );
            timers.push(t);
          });
        } catch (e) {
          html.classList.remove("booting"); // never trap the visitor on an error
        }

        bootCleanup = function () {
          if (raf) cancelAnimationFrame(raf);
          timers.forEach((t) => window.clearTimeout(t));
        };
      }

      let introCleanup = null;
      function initIntro() {
        if (introCleanup) {
          introCleanup();
          introCleanup = null;
        }
        const body = document.body;
        const intro = document.querySelector(".intro");
        if (!intro) {
          body.classList.remove("has-intro", "at-top");
          body.style.removeProperty("--intro-progress");
          return;
        }
        body.classList.add("has-intro");
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const arrow = intro.querySelector("[data-intro-scroll]");

        function onScroll() {
          const y = window.scrollY || 0;
          const h = window.innerHeight || 1;
          const progress = Math.min(y / (h * 0.85), 1);
          body.style.setProperty("--intro-progress", progress.toFixed(3));
          body.classList.toggle("at-top", y < 8);
          // The scroll cue shows immediately while at the top (change 1: the old
          // 4s idle delay was removed) and hides once the visitor scrolls away.
          if (arrow) arrow.classList.toggle("is-visible", y < 8);
        }
        function onArrowClick() {
          window.scrollTo({ top: window.innerHeight, behavior: reduce ? "auto" : "smooth" });
        }

        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
        if (arrow) arrow.addEventListener("click", onArrowClick);

        introCleanup = function () {
          window.removeEventListener("scroll", onScroll);
          if (arrow) arrow.removeEventListener("click", onArrowClick);
        };
      }

      // Static vector-dot background (change 6): a still field of dots behind the
      // intro GIFs. Dot size and shade co-vary in a subtle macroscopic wave (bigger
      // = lighter, smaller = darker); white in dark theme, ultraviolet in light, all
      // 70% transparent. Drawn once (and on resize / theme switch); no animation and
      // no interaction with the name/subtitle/GIFs. Purely decorative.
      let dotsCleanup = null;
      function initDots() {
        if (dotsCleanup) {
          dotsCleanup();
          dotsCleanup = null;
        }
        const canvas = document.querySelector("[data-dots]");
        if (!canvas) return;
        const intro = canvas.closest(".intro");
        const ctx = canvas.getContext("2d");
        if (!intro || !ctx) return;

        const SPACING = 32; // distance between dots (CSS px)
        const ALPHA = 0.3; // 70% transparent: subtle, never over-highlighting

        function draw() {
          const rect = intro.getBoundingClientRect();
          const W = Math.max(1, Math.round(rect.width));
          const H = Math.max(1, Math.round(rect.height));
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(W * dpr);
          canvas.height = Math.round(H * dpr);
          canvas.style.width = W + "px";
          canvas.style.height = H + "px";
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, W, H);

          const light = document.documentElement.getAttribute("data-theme") === "light";
          // Two gentle sine waves (scaled to the viewport, on the two diagonals)
          // combine into a soft organic undulation; one wave value drives both the
          // size and the shade of each dot, so the wave reads macroscopically.
          const baseLen = Math.max(W, H) / 2.6;
          const k1x = (Math.PI * 2) / baseLen,
            k1y = (Math.PI * 2) / (baseLen * 1.22);
          const k2x = (Math.PI * 2) / (baseLen * 0.7),
            k2y = (Math.PI * 2) / (baseLen * 0.86);

          for (let y = SPACING / 2; y < H; y += SPACING) {
            for (let x = SPACING / 2; x < W; x += SPACING) {
              const wv = (Math.sin(x * k1x + y * k1y) + Math.sin(x * k2x - y * k2y)) / 2; // [-1,1]
              const w = (wv + 1) / 2; // [0,1]
              const radius = 1.0 + w * 1.6; // ~1.0 .. 2.6 px: bigger at the wave peaks
              let col;
              if (light) {
                // ultraviolet: darker violet (small) -> lighter violet (big)
                const r = Math.round(74 + w * 81); // 74 -> 155
                const g = Math.round(56 + w * 72); // 56 -> 128
                const b = Math.round(140 + w * 78); // 140 -> 218
                col = "rgba(" + r + "," + g + "," + b + "," + ALPHA + ")";
              } else {
                // white: dim grey (small) -> white (big)
                const v = Math.round(150 + w * 105); // 150 -> 255
                col = "rgba(" + v + "," + v + "," + v + "," + ALPHA + ")";
              }
              ctx.beginPath();
              ctx.arc(x, y, radius, 0, Math.PI * 2);
              ctx.fillStyle = col;
              ctx.fill();
            }
          }
        }

        draw();
        const onResize = () => draw();
        window.addEventListener("resize", onResize);
        // Redraw on theme switch so the dot colour follows the active theme.
        const mo = new MutationObserver(() => draw());
        mo.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

        dotsCleanup = function () {
          window.removeEventListener("resize", onResize);
          mo.disconnect();
        };
      }

      // Project carousel (change 4 + slide update): an auto-advancing slideshow with
      // two switchable modes. Slides glide horizontally with an ease-out curve (fast
      // start, decelerating to a smooth stop; the easing lives in the CSS transition).
      // A trailing clone of slide 0 gives a seamless forward loop. Manual prev/next +
      // dots; 3s per slide; pauses on hover/focus; no auto-advance under reduced motion.
      let carouselCleanup = null;
      function initCarousel() {
        if (carouselCleanup) {
          carouselCleanup();
          carouselCleanup = null;
        }
        const root = document.querySelector("[data-carousel]");
        if (!root) return;
        const tracks = Array.from(root.querySelectorAll("[data-carousel-track]"));
        if (!tracks.length) return;
        const modeBtns = Array.from(root.querySelectorAll("[data-carousel-mode]"));
        const prevBtn = root.querySelector("[data-carousel-prev]");
        const nextBtn = root.querySelector("[data-carousel-next]");
        const dotsWrap = root.querySelector("[data-carousel-dots]");
        const caption = root.querySelector("[data-carousel-caption]");
        const playPauseBtn = root.querySelector("[data-carousel-playpause]");
        const enlargeBtn = root.querySelector("[data-carousel-enlarge]");
        const lightbox = root.querySelector("[data-carousel-lightbox]");
        const dialogOk =
          typeof HTMLDialogElement !== "undefined" && !!document.createElement("dialog").showModal;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const DELAY = 3000;

        // Reveal the no-JS hidden slides so the whole strip lays out, then append a
        // trailing clone of slide 0 to each track for a seamless forward loop.
        const realCount = [];
        tracks.forEach((t, m) => {
          const slides = Array.from(t.querySelectorAll("[data-carousel-slide]"));
          slides.forEach((s) => (s.hidden = false));
          realCount[m] = slides.length;
          if (slides.length > 1) {
            const clone = slides[0].cloneNode(true);
            clone.removeAttribute("data-carousel-slide");
            clone.setAttribute("data-carousel-clone", "");
            clone.setAttribute("aria-hidden", "true");
            t.appendChild(clone);
          }
        });
        // A single-image gallery (e.g. the Pricing project) has no sliding: hide the
        // arrows, dots and pause toggle, and skip auto-advance. Enlarge stays.
        const single = realCount.every((c) => c <= 1);

        let mode = 0,
          index = 0,
          timer = 0,
          animating = false,
          animTimer = 0,
          userPaused = false, // set by the pause/play toggle
          lbOpen = false; // true while the Enlarge lightbox is open

        function setTransform(track, idx, animate) {
          if (!animate) track.style.transition = "none";
          track.style.transform = "translateX(" + -idx * 100 + "%)";
          if (!animate) {
            void track.offsetWidth; // commit the jump with no transition
            track.style.transition = "";
          }
        }
        function beginAnim() {
          animating = true;
          if (animTimer) window.clearTimeout(animTimer);
          animTimer = window.setTimeout(finishAnim, 900); // fallback if transitionend is missed
        }
        function finishAnim() {
          if (animTimer) {
            window.clearTimeout(animTimer);
            animTimer = 0;
          }
          animating = false;
          if (index >= realCount[mode]) {
            // we glided onto the trailing clone; snap back to the real first slide
            index = 0;
            setTransform(tracks[mode], 0, false);
            renderChrome();
          }
        }
        function renderChrome() {
          modeBtns.forEach((b, m) => b.setAttribute("aria-pressed", String(m === mode)));
          const n = realCount[mode];
          const shown = ((index % n) + n) % n;
          if (dotsWrap) {
            Array.from(dotsWrap.children).forEach((d, i) => d.classList.toggle("is-active", i === shown));
          }
          if (caption) caption.textContent = n > 1 ? " · " + (shown + 1) + " / " + n : "";
        }
        function buildDots() {
          if (!dotsWrap) return;
          dotsWrap.textContent = "";
          for (let i = 0; i < realCount[mode]; i++) {
            const target = i;
            const b = document.createElement("button");
            b.type = "button";
            b.className = "carousel__dot";
            b.setAttribute("aria-label", "Go to slide " + (i + 1));
            b.addEventListener("click", () => {
              goTo(target);
              restart();
            });
            dotsWrap.appendChild(b);
          }
        }
        function goTo(i) {
          if (animating || realCount[mode] <= 1 || i === index) return;
          beginAnim();
          index = i;
          setTransform(tracks[mode], index, true);
          renderChrome();
        }
        function next() {
          if (animating || realCount[mode] <= 1) return;
          beginAnim();
          index += 1; // may land on the trailing clone (index === realCount[mode])
          setTransform(tracks[mode], index, true);
          renderChrome();
        }
        function prev() {
          if (animating || realCount[mode] <= 1) return;
          const n = realCount[mode];
          beginAnim();
          if (index === 0) {
            // jump (no transition) onto the clone, which looks identical to slide 0,
            // then glide to the real last slide: a seamless backward wrap.
            setTransform(tracks[mode], n, false);
            index = n - 1;
            requestAnimationFrame(() => setTransform(tracks[mode], index, true));
          } else {
            index -= 1;
            setTransform(tracks[mode], index, true);
          }
          renderChrome();
        }
        function onTransitionEnd(e) {
          if (e.target !== tracks[mode] || e.propertyName !== "transform") return;
          finishAnim();
        }
        function setMode(m) {
          if (m === mode || animating) return;
          tracks[mode].hidden = true;
          mode = m;
          index = 0;
          tracks[mode].hidden = false;
          setTransform(tracks[mode], 0, false);
          buildDots();
          renderChrome();
        }
        function stop() {
          if (timer) {
            window.clearInterval(timer);
            timer = 0;
          }
        }
        function start() {
          if (reduce || userPaused || lbOpen || single) return; // honour pause/lightbox/single
          stop();
          timer = window.setInterval(next, DELAY);
        }
        function restart() {
          stop();
          start();
        }

        // Manual pause/play toggle (change 4). Updates the icon (CSS swaps the
        // pause/play glyph off the is-paused class) and the accessible label.
        function setPaused(p) {
          userPaused = p;
          if (playPauseBtn) {
            playPauseBtn.classList.toggle("is-paused", p);
            playPauseBtn.setAttribute("aria-pressed", String(p));
            playPauseBtn.setAttribute("aria-label", p ? "Play slideshow" : "Pause slideshow");
          }
          if (p) stop();
          else start();
        }

        // Enlarge lightbox (change 4): a native <dialog> showing the current
        // mode's slides at readable size, with its own prev/next. Pauses
        // auto-advance while open and resumes (honouring the manual pause) on close.
        let lbImgs = [],
          lbIndex = 0;
        function renderLightbox() {
          if (!lightbox) return;
          const img = lightbox.querySelector("[data-lightbox-img]");
          const cap = lightbox.querySelector("[data-lightbox-cap]");
          const navs = lightbox.querySelectorAll("[data-lightbox-prev],[data-lightbox-next]");
          const n = lbImgs.length;
          if (!n) return;
          const shown = ((lbIndex % n) + n) % n;
          const cur = lbImgs[shown];
          if (img) {
            img.src = cur.src;
            img.alt = cur.alt;
          }
          if (cap) cap.textContent = shown + 1 + " / " + n;
          navs.forEach((b) => (b.hidden = n <= 1));
        }
        function openLightbox() {
          if (!lightbox || !dialogOk) return;
          const slides = Array.from(tracks[mode].querySelectorAll("[data-carousel-slide]"));
          lbImgs = slides.map((im) => ({
            src: im.currentSrc || im.getAttribute("src"),
            alt: im.getAttribute("alt") || "",
          }));
          if (!lbImgs.length) return;
          const n = realCount[mode];
          lbIndex = ((index % n) + n) % n;
          renderLightbox();
          lbOpen = true;
          stop();
          lightbox.showModal();
        }
        function closeLightbox() {
          lbOpen = false;
          if (lightbox && lightbox.open) lightbox.close();
          start();
        }
        function lbStep(d) {
          const n = lbImgs.length;
          if (n <= 1) return;
          lbIndex = (((lbIndex + d) % n) + n) % n;
          renderLightbox();
        }

        tracks.forEach((t) => t.addEventListener("transitionend", onTransitionEnd));
        modeBtns.forEach((b, m) =>
          b.addEventListener("click", () => {
            setMode(m);
            restart();
          })
        );
        if (prevBtn)
          prevBtn.addEventListener("click", () => {
            prev();
            restart();
          });
        if (nextBtn)
          nextBtn.addEventListener("click", () => {
            next();
            restart();
          });
        // Single-image gallery: nothing to navigate, so hide the arrows and dots.
        if (single) {
          if (prevBtn) prevBtn.hidden = true;
          if (nextBtn) nextBtn.hidden = true;
          if (dotsWrap) dotsWrap.hidden = true;
        }
        // Pause/play: only meaningful when something can auto-advance. Hide the
        // toggle under reduced motion or when every mode has a single slide.
        const canAutoplay = !reduce && !single;
        if (playPauseBtn) {
          if (canAutoplay) playPauseBtn.addEventListener("click", () => setPaused(!userPaused));
          else playPauseBtn.hidden = true;
        }
        // Enlarge: needs a working <dialog>. Otherwise hide the button.
        if (enlargeBtn) {
          if (lightbox && dialogOk) enlargeBtn.addEventListener("click", openLightbox);
          else enlargeBtn.hidden = true;
        }
        if (lightbox && dialogOk) {
          const lbPrev = lightbox.querySelector("[data-lightbox-prev]");
          const lbNext = lightbox.querySelector("[data-lightbox-next]");
          const lbClose = lightbox.querySelector("[data-lightbox-close]");
          if (lbPrev) lbPrev.addEventListener("click", () => lbStep(-1));
          if (lbNext) lbNext.addEventListener("click", () => lbStep(1));
          if (lbClose) lbClose.addEventListener("click", closeLightbox);
          lightbox.addEventListener("cancel", (e) => {
            e.preventDefault(); // animate/handle the Escape close ourselves
            closeLightbox();
          });
          lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) closeLightbox(); // click on the backdrop padding
          });
        }

        root.addEventListener("mouseenter", stop);
        root.addEventListener("mouseleave", start);
        root.addEventListener("focusin", stop);
        root.addEventListener("focusout", start);

        tracks.forEach((t, m) => {
          t.hidden = m !== 0;
          setTransform(t, 0, false);
        });
        buildDots();
        renderChrome();
        start();

        carouselCleanup = function () {
          stop();
          if (animTimer) window.clearTimeout(animTimer);
          if (lightbox && lightbox.open) lightbox.close();
        };
      }

      // On-card preview slideshows (change 4): the masked Telstra dashboard cards
      // cross-fade through their gallery images. Static first image without JS or
      // under reduced motion (and when a card has a single image).
      let cardPreviewCleanup = null;
      function initCardPreviews() {
        if (cardPreviewCleanup) {
          cardPreviewCleanup();
          cardPreviewCleanup = null;
        }
        const previews = Array.from(document.querySelectorAll("[data-card-preview]"));
        if (!previews.length) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const timers = [];
        previews.forEach((pv) => {
          const imgs = Array.from(pv.querySelectorAll(".card__preview-img"));
          if (imgs.length <= 1 || reduce) return;
          let i = 0;
          const t = window.setInterval(() => {
            imgs[i].classList.remove("is-active");
            i = (i + 1) % imgs.length;
            imgs[i].classList.add("is-active");
          }, 2800);
          timers.push(t);
        });
        cardPreviewCleanup = function () {
          timers.forEach((t) => window.clearInterval(t));
        };
      }

      // Experience detail modals (change): the timeline "Details | Achievements"
      // buttons (and the Assistant-Manager redirect link) open a native <dialog>
      // with a pop-out animation and a blurred backdrop, instead of navigating.
      // Without JS or without <dialog> support, the links navigate to
      // /experience/<slug>/ as before (progressive enhancement).
      let expModalCleanup = null;
      function initExperienceModals() {
        if (expModalCleanup) {
          expModalCleanup();
          expModalCleanup = null;
        }
        const dialogs = Array.from(document.querySelectorAll("[data-exp-modal]"));
        const triggers = Array.from(document.querySelectorAll("[data-exp-open]"));
        if (!dialogs.length || !triggers.length) return;
        if (typeof HTMLDialogElement === "undefined" || !document.createElement("dialog").showModal) return;

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const bySlug = {};
        dialogs.forEach((d) => (bySlug[d.getAttribute("data-exp-modal")] = d));
        let current = null;

        function lockScroll(on) {
          document.documentElement.style.overflow = on ? "hidden" : "";
        }
        function finalClose(d) {
          if (d.open) d.close();
          if (current === d) {
            current = null;
            lockScroll(false);
          }
        }
        function closeModal(d) {
          if (!d || !d.open) return;
          d.classList.remove("is-open");
          if (reduce) {
            finalClose(d);
            return;
          }
          let done = false;
          const finish = () => {
            if (done) return;
            done = true;
            d.removeEventListener("transitionend", onEnd);
            finalClose(d);
          };
          const onEnd = (e) => {
            if (e.target === d && e.propertyName === "transform") finish();
          };
          d.addEventListener("transitionend", onEnd);
          window.setTimeout(finish, 420); // fallback if transitionend is missed
        }
        function openModal(slug) {
          const d = bySlug[slug];
          if (!d || d.open) return;
          // Swap instantly if another modal is open (e.g. the AM -> Consultant link).
          if (current && current !== d) {
            current.classList.remove("is-open");
            finalClose(current);
          }
          d.showModal();
          current = d;
          lockScroll(true);
          if (reduce) {
            d.classList.add("is-open");
            return;
          }
          void d.offsetWidth; // commit the closed (pre-animation) styles before animating in
          d.classList.add("is-open");
        }

        function onTriggerClick(e) {
          const slug = e.currentTarget.getAttribute("data-exp-open");
          if (!bySlug[slug]) return; // no modal for this slug -> let the link navigate
          e.preventDefault();
          openModal(slug);
        }
        triggers.forEach((t) => t.addEventListener("click", onTriggerClick));

        const bound = [];
        dialogs.forEach((d) => {
          const onBackdrop = (e) => {
            if (e.target === d) closeModal(d); // click on the exposed/blurred backdrop
          };
          const onCancel = (e) => {
            e.preventDefault(); // animate the Escape-key close instead of an instant close
            closeModal(d);
          };
          const closeBtn = d.querySelector("[data-exp-close]");
          const onClose = () => closeModal(d);
          d.addEventListener("click", onBackdrop);
          d.addEventListener("cancel", onCancel);
          if (closeBtn) closeBtn.addEventListener("click", onClose);
          bound.push({ d, onBackdrop, onCancel, closeBtn, onClose });
        });

        expModalCleanup = function () {
          triggers.forEach((t) => t.removeEventListener("click", onTriggerClick));
          bound.forEach(({ d, onBackdrop, onCancel, closeBtn, onClose }) => {
            d.removeEventListener("click", onBackdrop);
            d.removeEventListener("cancel", onCancel);
            if (closeBtn) closeBtn.removeEventListener("click", onClose);
            if (d.open) d.close();
          });
          lockScroll(false);
        };
      }

      function init() {
        applyTheme();
        initBoot();
        initThemeToggle();
        initNav();
        initProjectsFlyout();
        initLensToggle();
        initContactCopy();
        initEmailToast();
        initReveal();
        initIntro();
        initDots();
        initCarousel();
        initCardPreviews();
        initExperienceModals();
        initScrollSpy();
      }

      document.addEventListener("astro:page-load", init);
      // On a View-Transition swap, Astro copies the incoming static <html>
      // attributes onto the persistent element, dropping the runtime classes the
      // head script set. Re-add `js` (gates progressive-enhancement CSS such as
      // the section index, the intro nav-hide and the scroll reveals) and re-apply
      // the theme, so both survive every client-side navigation.
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("js");
        applyTheme();
      });
    </script>

    <script>
      import "../scripts/lemmino.js";
    </script>
  </body>
</html>
